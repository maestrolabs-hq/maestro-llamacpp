# Editor settings every repository in this organisation shares.
#
# Polyglot on purpose: a contributor should not have to know which language a
# file belongs to before their editor does the right thing. Indentation follows
# each ecosystem's own convention rather than one house style, because fighting
# a formatter produces churn that reviews then have to absorb.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4
max_line_length = 100

# ── Rust ────────────────────────────────────────────────────────────────────
# rustfmt's defaults, stated so an editor matches them before rustfmt runs.
[*.rs]
indent_size = 4
max_line_length = 100

# ── JavaScript, TypeScript and their config ─────────────────────────────────
# Two spaces is what Biome emits; anything else is reformatted on save.
[*.{js,mjs,cjs,jsx,ts,mts,cts,tsx}]
indent_size = 2

[*.{json,jsonc,json5}]
indent_size = 2

# ── Python ──────────────────────────────────────────────────────────────────
# Four spaces and 100 columns, matching ruff's configured line-length.
[*.{py,pyi}]
indent_size = 4
max_line_length = 100

# ── Data and markup ─────────────────────────────────────────────────────────
# YAML cannot be indented with tabs at all, and two spaces is universal.
[*.{yml,yaml}]
indent_size = 2

[*.toml]
indent_size = 4

[*.{md,markdown}]
indent_size = 2
# Two trailing spaces are a hard line break in Markdown; stripping them
# silently changes the rendered output.
trim_trailing_whitespace = false

# ── Shell and task runners ──────────────────────────────────────────────────
[*.{sh,bash,zsh}]
indent_size = 2

# Recipe bodies are indented, and just is not whitespace-sensitive the way make
# is, but keeping them apart avoids surprises when a recipe grows a heredoc.
[justfile]
indent_size = 4

# Make requires literal tabs. This is not a preference.
[{Makefile,makefile,*.mk}]
indent_style = tab

# ── Generated and vendored ──────────────────────────────────────────────────
# Never reformatted, because the tool that wrote them owns their shape.
[{*.lock,package-lock.json,Cargo.lock,uv.lock,poetry.lock}]
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_size = unset

# Captured third-party configuration must stay byte-identical to its source.
[config/**]
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_size = unset
